#ifdef SM_5
#include "common.h"
/*
struct 	v2p
{
//D3DFVF_XYZRHW|D3DFVF_DIFFUSE|D3DFVF_SPECULAR|D3DFVF_TEX3
	float4 	color:		COLOR0;		// multiplier, color.w = noise_amount
	float4	gray:		COLOR1;		// (.3,.3,.3.,amount)
 	float2 	tc0: 		TEXCOORD0;	// base1 (duality)
 	float2 	tc1: 		TEXCOORD1;	// base2 (duality)
 	float2 	tc2: 		TEXCOORD2;	// base  (noise)
};
*/

Texture2D 	s_base0;
Texture2D 	s_base1;
Texture2D 	s_noise;
uniform float4 		c_brightness;
#ifdef USE_LINEAR_RENDERING
uniform float4 linear_display_params;
#endif
Texture2D 	s_grad0;
Texture2D 	s_grad1;
uniform float4 		c_colormap;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main( p_postpr I ) : SV_Target
{
//	float3	t_0 	= tex2D		(s_base0,I.tc0);
//	float3	t_1 	= tex2D		(s_base1,I.tc1);
	float3	t_0 	= s_base0.Sample( smp_rtlinear, I.Tex0);
	float3	t_1 	= s_base1.Sample( smp_rtlinear, I.Tex1);	
	float3 	image_o	= (t_0+t_1)*.5;
#ifdef USE_LINEAR_RENDERING
    image_o = linear_display_params.x != 0.0 ? linear_to_srgb(linear_display_map(image_o * s_tonemap.Load(int3(0, 0, 0)).x)) : linear_to_srgb(image_o);
#endif					// add_d2

    float3 image = image_o;
    // These are uniform effect controls; do not sample inactive colour maps.
    [branch] if (c_colormap.x != 0.0)
    {
        float grad_i = dot(image_o, (0.3333h).xxx);
        float2 uv = float2(grad_i, 0.5);
        float3 mapped;
        [branch] if (c_colormap.y == 0.0)
            mapped = s_grad0.Sample(smp_rtlinear, uv).rgb;
        else if (c_colormap.y == 1.0)
            mapped = s_grad1.Sample(smp_rtlinear, uv).rgb;
        else
            mapped = lerp(s_grad0.Sample(smp_rtlinear, uv).rgb,
                s_grad1.Sample(smp_rtlinear, uv).rgb, c_colormap.y);
        image = lerp(image_o, mapped, c_colormap.x);
    }
	float	gray 	= dot		(image,I.Gray);			// dp3
			image 	= lerp 		(gray,image,I.Gray.w);		// mul/mad

    // Derivatives outside the branch also support non-uniform vertex colours.
    float2 noiseDx = ddx(I.Tex2), noiseDy = ddy(I.Tex2);
    [branch] if (I.Color.w != 1.0)
    {
        float3 noise = s_noise.SampleGrad(smp_linear, I.Tex2, noiseDx, noiseDy).rgb;
        image = lerp(image * noise * 2.0, image, I.Color.w);
    }			image	= (image * I.Color + c_brightness)*2;		// mad
//		image	= (image + c_brightness) * I.Color;		// mad ?

	// out
	#ifdef USE_LINEAR_RENDERING
    image = srgb_to_linear(saturate(image));
#endif
    return float4(image, 1.0h);					// +mov
}

#else
#include "common.h"
/*
struct 	v2p
{
//D3DFVF_XYZRHW|D3DFVF_DIFFUSE|D3DFVF_SPECULAR|D3DFVF_TEX3
	float4 	color:		COLOR0;		// multiplier, color.w = noise_amount
	float4	gray:		COLOR1;		// (.3,.3,.3.,amount)
 	float2 	tc0: 		TEXCOORD0;	// base1 (duality)
 	float2 	tc1: 		TEXCOORD1;	// base2 (duality)
 	float2 	tc2: 		TEXCOORD2;	// base  (noise)
};
*/

Texture2D 	s_base0;
Texture2D 	s_base1;
Texture2D 	s_noise;
uniform float4 		c_brightness;
#ifdef USE_LINEAR_RENDERING
uniform float4 linear_display_params;
#endif
Texture2D 	s_grad0;
Texture2D 	s_grad1;
uniform float4 		c_colormap;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main( p_postpr I ) : SV_Target
{
//	float3	t_0 	= tex2D		(s_base0,I.tc0);
//	float3	t_1 	= tex2D		(s_base1,I.tc1);
	float3	t_0 	= s_base0.Sample( smp_rtlinear, I.Tex0);
	float3	t_1 	= s_base1.Sample( smp_rtlinear, I.Tex1);	
	float3 	image_o	= (t_0+t_1)*.5;
#ifdef USE_LINEAR_RENDERING
    image_o = linear_display_params.x != 0.0 ? linear_to_srgb(linear_display_map(image_o * s_tonemap.Load(int3(0, 0, 0)).x)) : linear_to_srgb(image_o);
#endif					// add_d2

	float	grad_i 	= dot		(image_o,(0.3333h).xxx);

	float3 	image0 	= s_grad0.Sample( smp_rtlinear, float2(grad_i,0.5));
	float3 	image1 	= s_grad1.Sample( smp_rtlinear, float2(grad_i,0.5));
	float3	image	= lerp		(image0, image1, c_colormap.y);
			image	= lerp		(image_o, image, c_colormap.x);

	float	gray 	= dot		(image,I.Gray);			// dp3
			image 	= lerp 		(gray,image,I.Gray.w);		// mul/mad

//	float4	t_noise	= tex2D		(s_noise,I.tc2);	
	float4	t_noise	= s_noise.Sample( smp_linear, I.Tex2);	
	float3 	noised 	= image*t_noise*2;                     		// mul_2x
			image	= lerp( noised, image, I.Color.w); 	// lrp ?
			image	= (image * I.Color + c_brightness)*2;		// mad
//		image	= (image + c_brightness) * I.Color;		// mad ?

	// out
	#ifdef USE_LINEAR_RENDERING
    image = srgb_to_linear(saturate(image));
#endif
    return float4(image, 1.0h);					// +mov
}

#endif
